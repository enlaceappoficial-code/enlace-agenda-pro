# Puerto del servidor backend Express
PORT=5184

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=https://agenda.redenlace.cl,http://localhost:5187

# Base de datos SQLite / Prisma
DATABASE_URL="file:./dev.db"

# Clave secreta para cookies de sesión
SESSION_SECRET="enlace_agenda_pro_super_secret_key_2026"

# Configuración de Cookies para producción (HTTPS)
# Si backend y frontend comparten *.redenlace.cl:
COOKIE_DOMAIN=.redenlace.cl
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
NODE_ENV=production

# Integración con Red Social ENLACE
APP_SLUG=agenda_pro
SUPABASE_URL=https://mlvzcipnjtcjabyoprrl.supabase.co
ENLACE_API_URL=https://mlvzcipnjtcjabyoprrl.supabase.co/functions/v1/enlace-api
