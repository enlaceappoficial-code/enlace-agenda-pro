generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum AppId {
  PELUQUERIA
  RESTORAN
  AGENDA_PRO
  ALMACEN
  FOOD_TRUCK
  CONSTRUCTOR_PRO
  BIENESTAR
  BOUTIQUE
  CLASES
  EVENTOS
  MASCOTAS
  FLETE
}

enum PlanId {
  BASIC
  PLUS
  PRO
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Shop {
  id                 String        @id @default(cuid())
  appId              AppId         @default(AGENDA_PRO)
  businessType       String        @default("salud")
  planId             PlanId        @default(BASIC)
  name               String
  phone              String?
  city               String?
  slug               String        @unique
  timezone           String        @default("America/Santiago")
  slotMinutes        Int           @default(30)
  openTime           String        @default("09:00")
  closeTime          String        @default("20:00")
  breakStart         String?
  breakEnd           String?
  activeDays         Json          @default("[1,2,3,4,5,6]")
  cancellationPolicy String        @default("Cancela con al menos 2 horas de anticipación.")
  enlaceProfileId    String?
  enlaceTokenApp     String?
  enlaceDisponible   Boolean       @default(false)
  enlaceMsg          String        @default("Disponible ahora")
  logoUrl            String?
  enlaceLastSyncAt   DateTime?
  depositEnabled          Boolean       @default(false)
  prepaymentEnabled       Boolean       @default(false)
  fastPaymentEnabled      Boolean       @default(false)
  barberBankName          String?
  barberBankAccountType   String?
  barberBankAccountNumber String?
  barberBankRut           String?
  barberBankOwnerName     String?
  barberBankEmail         String?
  subscriptionEndsAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  services     Service[]
  clients      Client[]
  appointments Appointment[]
  galleryItems GalleryItem[]
  admins       AdminUser[]
  outbox       EnlaceOutbox[]
  monthlyExpenses MonthlyExpense[]
  blockedSlots    BlockedSlot[]
  professionals   Professional[]
  cashExtras      CashExtra[]
}

model AdminUser {
  id           String   @id @default(cuid())
  shopId       String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  category    String
  durationMin Int
  price       Int
  description String?
  active      Boolean  @default(true)
  costMaterials  Float @default(0)
  costEquipment  Float @default(0)
  costTotal      Float @default(0)
  depositRequired Boolean @default(false)
  depositAmount   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([shopId])
}

model Client {
  id        String   @id @default(cuid())
  shopId    String
  fullName  String
  phone     String?
  email     String?
  notes     String?
  colorFormula String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([shopId])
}

model Appointment {
  id                    String            @id @default(cuid())
  shopId                String
  serviceId             String
  clientId              String?
  guestName             String?
  guestPhone            String?
  guestEmail            String?
  notes                 String?
  price                 Int
  enlaceCalendarEventId String?
  professionalId        String?
  startsAt              DateTime
  endsAt                DateTime
  status                AppointmentStatus @default(PENDING)
  depositPaid           Boolean           @default(false)
  depositReceiptUrl     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([shopId, startsAt])
  @@index([professionalId])
  @@index([serviceId])
  @@index([clientId])
}

model GalleryItem {
  id          String   @id @default(cuid())
  shopId      String
  category    String?
  description String
  photos      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

model EnlaceOutbox {
  id            String       @id @default(cuid())
  shopId        String
  endpoint      String
  method        String
  body          Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status, nextAttemptAt])
}

model MonthlyExpense {
  id          String   @id @default(cuid())
  shopId      String
  nombre      String
  monto       Float
  categoria   String   @default("general")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@index([shopId])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  shopId    String
  date      String
  startTime String
  endTime   String
  reason    String?
  professionalId String?
  createdAt      DateTime @default(now())
  
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  
  @@index([shopId])
  @@index([professionalId])
}

model Professional {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  title     String?  @default("Barbero")
  photo     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  blockedSlots BlockedSlot[]

  @@index([shopId])
}

model CashExtra {
  id        String   @id @default(cuid())
  shopId    String
  date      String   // ISO YYYY-MM-DD
  concept   String
  amount    Float
  type      String   // 'ingreso' or 'egreso'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, date])
}

model AccessCode {
  id             String   @id @default(cuid())
  code           String   @unique
  planId         PlanId
  appId          AppId    @default(PELUQUERIA)
  rutClient      String?
  clientName     String?
  clientPhone    String?
  clientEmail    String?
  clientCity     String?
  durationMonths Int      // 6 o 12
  maxUses        Int      @default(1)
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
